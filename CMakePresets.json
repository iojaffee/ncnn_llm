{
  "version": 6,
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "vcpkg: system ncnn + nlohmann-json",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/.local/share/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "USE_SYSTEM_NCNN": "ON",
        "NCNN_LLM_ENABLE_VULKAN": "OFF",
        "OpenMP_C_FLAGS": "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include",
        "OpenMP_CXX_FLAGS": "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include",
        "OpenMP_C_LIB_NAMES": "omp",
        "OpenMP_CXX_LIB_NAMES": "omp",
        "OpenMP_omp_LIBRARY": "/opt/homebrew/opt/libomp/lib/libomp.dylib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg"
    }
  ]
}
